---
import "../styles/globals.css";
import { Store } from "lucide-react";

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "ShopLoc — Collectiv'IT",
  description = "Application de fidélité pour l'ensemble des commerçants d'une municipalité",
} = Astro.props;
---

<!doctype html>
<html lang="fr" class="h-full antialiased">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <meta name="description" content={description} />
  </head>
  <body class="min-h-full flex flex-col bg-background text-foreground">
    <header class="sticky top-0 z-50 w-full border-b bg-background/95 backdrop-blur-md">
      <div class="container mx-auto flex h-16 items-center justify-between px-4 sm:px-6">
        <a href="/" class="flex items-center gap-2 font-bold text-xl tracking-tight">
          <div class="flex size-9 items-center justify-center rounded-lg bg-primary text-primary-foreground">
            <Store className="size-5" />
          </div>
          <span>ShopLoc</span>
          <span class="text-xs text-muted-foreground font-normal border-l pl-2 ml-1">
            Collectiv'IT
          </span>
        </a>
      </div>
    </header>

    <div class="flex-1">
      <slot />
    </div>
  </body>
</html>
